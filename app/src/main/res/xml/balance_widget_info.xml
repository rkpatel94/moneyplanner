<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis is what keeps "Available now" true while the app is closed. The balance
    depends on the date as well as the records, because an expense or salary entered ahead of
    time only counts once its day arrives, and without a period the system repaints only when
    the widget is placed, after a reboot or after an update. Every three hours keeps the figure
    at most a few hours behind midnight for the cost of a handful of local reads a day; opening
    the app repaints it at once.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="72dp"
    android:initialLayout="@layout/balance_widget"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:widgetCategory="home_screen" />
